---
import SectionTitle from '@/components/ui/SectionTitle.astro';
import { useTranslations } from '@/i18n/ui';
import type { Lang } from '@/types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  id="about"
  class="nb-border border-t-0 border-x-0 border-b-2"
>
  <div class="max-w-5xl p-8 md:p-16 lg:p-24 flex flex-col justify-center">
    <SectionTitle title={t('about.title')} index="01" />
    <p class="reveal text-lg leading-relaxed max-w-2xl">
      {t('about.body')}
    </p>

    <!-- Quick facts -->
    <dl class="reveal mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="nb-border nb-shadow p-4">
        <dt class="text-label text-[var(--color-muted)] mb-1">
          {lang === 'en' ? 'Education' : 'Formación'}
        </dt>
        <dd class="font-bold">UPNA — {lang === 'en' ? 'Computer Engineering' : 'Ing. Informática'}</dd>
      </div>
      <div class="nb-border nb-shadow p-4">
        <dt class="text-label text-[var(--color-muted)] mb-1">
          {lang === 'en' ? 'Currently' : 'Actualmente'}
        </dt>
        <dd class="font-bold">{lang === 'en' ? 'MSc Cybersecurity' : 'Máster Ciberseguridad'}</dd>
      </div>
      <div class="nb-border nb-shadow p-4">
        <dt class="text-label text-[var(--color-muted)] mb-1">
          {lang === 'en' ? 'Based in' : 'Ubicación'}
        </dt>
        <dd class="font-bold">Navarra, España</dd>
      </div>
      <div class="nb-border nb-shadow p-4">
        <dt class="text-label text-[var(--color-muted)] mb-1">
          {lang === 'en' ? 'Focus' : 'Especialidad'}
        </dt>
        <dd class="font-bold">{lang === 'en' ? 'Security & Systems' : 'Seguridad & Sistemas'}</dd>
      </div>
    </dl>
  </div>
</section>
