---
interface Props {
  images: string[];
  alt: string;
}

const { images, alt } = Astro.props;
---

<div class="screenshot-gallery" style={`--count:${images.length}`}>
  <div class="screenshot-gallery-viewport">
    <div class="screenshot-gallery-track" role="list">
      {images.map((src, i) => (
        <button type="button" class="screenshot-gallery-thumb" data-index={i} aria-label={`${alt} ${i + 1}/${images.length}`}>
          <img src={src} alt={`${alt} ${i + 1}`} loading="lazy" />
        </button>
      ))}
    </div>
  </div>

  {images.length > 1 && (
    <div class="screenshot-gallery-controls">
      <button type="button" class="screenshot-gallery-arrow screenshot-gallery-prev" aria-label="Previous">←</button>
      <p class="screenshot-gallery-counter"></p>
      <button type="button" class="screenshot-gallery-arrow screenshot-gallery-next" aria-label="Next">→</button>
    </div>
  )}

  <div class="screenshot-lightbox" hidden>
    <button type="button" class="screenshot-lightbox-close" aria-label="Close">✕</button>
    <button type="button" class="screenshot-lightbox-nav screenshot-lightbox-prev" aria-label="Previous">←</button>
    <img class="screenshot-lightbox-img" src="" alt="" />
    <button type="button" class="screenshot-lightbox-nav screenshot-lightbox-next" aria-label="Next">→</button>
    <p class="screenshot-lightbox-counter"></p>
  </div>
</div>

<style>
  .screenshot-gallery {
    width: 100%;
    max-width: 100%;
  }

  .screenshot-gallery-viewport {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .screenshot-gallery-track {
    display: flex;
    gap: 1rem;
    will-change: transform;
    transition: transform 0.35s ease;
  }

  .screenshot-gallery-thumb {
    flex: 0 0 calc((100% - 2rem) / 3);
    aspect-ratio: 4 / 3;
    cursor: zoom-in;
    padding: 0;
    background: var(--color-paper);
    border: 2px solid var(--color-ink);
    box-shadow: 4px 4px 0 var(--color-ink);
    overflow: hidden;
  }

  .screenshot-gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .screenshot-gallery-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .screenshot-gallery-arrow {
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    background: var(--color-white);
    border: 2px solid var(--color-ink);
    box-shadow: 3px 3px 0 var(--color-ink);
    font-weight: 700;
    cursor: pointer;
  }

  .screenshot-gallery-arrow:disabled {
    opacity: 0.35;
    cursor: default;
    box-shadow: none;
  }

  .screenshot-gallery-counter {
    text-align: center;
    min-width: 4.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .screenshot-gallery-thumb {
      flex-basis: calc((100% - 1rem) / 2);
    }
  }

  @media (max-width: 560px) {
    .screenshot-gallery-thumb {
      flex-basis: 100%;
    }
  }

  .screenshot-lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(10, 10, 10, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .screenshot-lightbox[hidden] {
    display: none;
  }

  .screenshot-lightbox-img {
    max-width: min(90vw, 1200px);
    max-height: 82vh;
    width: auto;
    height: auto;
    border: 2px solid var(--color-paper);
    object-fit: contain;
  }

  .screenshot-lightbox-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 44px;
    height: 44px;
    background: var(--color-paper);
    border: 2px solid var(--color-ink);
    font-weight: 700;
    cursor: pointer;
  }

  .screenshot-lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    background: var(--color-paper);
    border: 2px solid var(--color-ink);
    font-weight: 700;
    font-size: 1.25rem;
    cursor: pointer;
  }

  .screenshot-lightbox-prev {
    left: 1rem;
  }

  .screenshot-lightbox-next {
    right: 1rem;
  }

  .screenshot-lightbox-counter {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-paper);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  @media (max-width: 640px) {
    .screenshot-lightbox-nav {
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  function itemsPerView(): number {
    const w = window.innerWidth;
    if (w <= 560) return 1;
    if (w <= 900) return 2;
    return 3;
  }

  function initGalleries() {
    document.querySelectorAll<HTMLElement>('.screenshot-gallery').forEach((gallery) => {
      if (gallery.dataset.wired === 'true') return;
      gallery.dataset.wired = 'true';

      const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.screenshot-gallery-thumb'));
      const sources = thumbs.map((t) => t.querySelector('img')!.src);
      const alts = thumbs.map((t) => t.querySelector('img')!.alt);
      const total = sources.length;

      const track = gallery.querySelector<HTMLElement>('.screenshot-gallery-track')!;
      const prevArrow = gallery.querySelector<HTMLButtonElement>('.screenshot-gallery-prev');
      const nextArrow = gallery.querySelector<HTMLButtonElement>('.screenshot-gallery-next');
      const galleryCounter = gallery.querySelector<HTMLElement>('.screenshot-gallery-counter');

      let page = 0;

      function maxPage() {
        return Math.max(0, total - itemsPerView());
      }

      function renderTrack() {
        const perView = itemsPerView();
        const itemWidth = 100 / perView;
        page = Math.min(page, maxPage());
        track.style.transform = `translateX(-${page * itemWidth}%)`;
        if (prevArrow) prevArrow.disabled = page <= 0;
        if (nextArrow) nextArrow.disabled = page >= maxPage();
        if (galleryCounter) galleryCounter.textContent = `${page + 1} / ${maxPage() + 1}`;
      }

      prevArrow?.addEventListener('click', () => {
        page = Math.max(0, page - 1);
        renderTrack();
      });
      nextArrow?.addEventListener('click', () => {
        page = Math.min(maxPage(), page + 1);
        renderTrack();
      });

      window.addEventListener('resize', renderTrack);
      renderTrack();

      // Lightbox
      const lightbox = gallery.querySelector<HTMLElement>('.screenshot-lightbox')!;
      const img = lightbox.querySelector<HTMLImageElement>('.screenshot-lightbox-img')!;
      const counter = lightbox.querySelector<HTMLElement>('.screenshot-lightbox-counter')!;
      const closeBtn = lightbox.querySelector<HTMLButtonElement>('.screenshot-lightbox-close')!;
      const lbPrevBtn = lightbox.querySelector<HTMLButtonElement>('.screenshot-lightbox-prev')!;
      const lbNextBtn = lightbox.querySelector<HTMLButtonElement>('.screenshot-lightbox-next')!;

      let current = 0;

      function show(index: number) {
        current = (index + total) % total;
        img.src = sources[current];
        img.alt = alts[current];
        counter.textContent = `${current + 1} / ${total}`;
      }

      function open(index: number) {
        show(index);
        lightbox.hidden = false;
        document.body.style.overflow = 'hidden';
      }

      function close() {
        lightbox.hidden = true;
        document.body.style.overflow = '';
      }

      thumbs.forEach((thumb, i) => {
        thumb.addEventListener('click', () => open(i));
      });

      closeBtn.addEventListener('click', close);
      lbPrevBtn.addEventListener('click', () => show(current - 1));
      lbNextBtn.addEventListener('click', () => show(current + 1));

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) close();
      });

      document.addEventListener('keydown', (e) => {
        if (lightbox.hidden) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });
    });
  }

  initGalleries();
  document.addEventListener('astro:page-load', initGalleries);
</script>
