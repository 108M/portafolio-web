---
// Full-screen QR to show from the phone at events. Points to /links.
import '@/styles/global.css';
import QRCode from 'qrcode';

const target = new URL('/links', Astro.site!).href;
const svg = await QRCode.toString(target, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 0,
  color: { dark: '#0a0a0a', light: '#ffffff' },
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Markel Álvarez — QR</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Mi QR" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[var(--color-ink)] min-h-svh flex items-center justify-center px-4 py-8">
    <main class="w-full max-w-sm flex flex-col gap-6 text-[var(--color-paper)]">
      <div class="text-center">
        <h1 class="font-bold uppercase leading-[0.9] tracking-[-0.03em] text-4xl">Markel Álvarez</h1>
        <p class="mt-2 text-label opacity-80">Software Engineer · Cybersecurity</p>
      </div>

      <div class="bg-[var(--color-white)] p-6 nb-border border-[var(--color-paper)]" style="box-shadow: 8px 8px 0 var(--color-green);">
        <div class="qr w-full aspect-square" set:html={svg} />
      </div>

      <p class="text-center text-label">Escanéame · Scan me</p>
      <p class="text-center text-sm opacity-60">markel108.dev/links</p>
    </main>
  </body>
</html>

<style>
  .qr :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
