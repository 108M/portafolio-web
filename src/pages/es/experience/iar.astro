---
import Layout from '@/layouts/Layout.astro';
import Tag from '@/components/ui/Tag.astro';
import { internship } from '@/data/internship';
import { useTranslations } from '@/i18n/ui';
import type { Lang } from '@/types';

const lang: Lang = 'es';
const t = useTranslations(lang);
const base = '/es';
---

<Layout
  title={`${internship.role[lang]} en ${internship.company} | Markel Álvarez`}
  description={internship.summary[lang]}
>
  <article>
    <!-- Header -->
    <header class="nb-border border-t-0 border-x-0 border-b-2 nb-texture px-6 md:px-12 py-16 md:py-24">
      <a
        href={`${base}/#experience`}
        class="inline-flex items-center gap-2 text-label mb-10 hover:underline underline-offset-4"
      >
        ← {t('internship.back')}
      </a>

      <p class="text-label text-[var(--color-muted)] mb-4 uppercase tracking-widest">
        Trabajo · {internship.roleProgression[lang]} · {internship.period}
      </p>
      <h1
        class="font-bold uppercase leading-[0.9] tracking-[-0.03em] mb-8"
        style="font-size: clamp(2.5rem, 7vw, 5.5rem);"
      >
        {internship.role[lang]}
      </h1>
      <p class="text-xl md:text-2xl leading-snug max-w-2xl mb-10">
        {internship.summary[lang]}
      </p>
      <div class="flex flex-wrap gap-2">
        {internship.stack.map((tech) => <Tag label={tech} />)}
      </div>
    </header>

    <!-- Body: content (left) / sidebar (right) -->
    <div class="grid grid-cols-1 lg:grid-cols-[1.6fr_1fr]">
      <!-- Left: context + tasks -->
      <div class="px-6 md:px-12 py-16 md:py-20 nb-border border-t-0 border-x-0 border-b-2 lg:border-b-0 lg:border-r-2 flex flex-col gap-14">
        <!-- Context -->
        <section>
          <h2 class="text-label text-[var(--color-muted)] mb-5">{t('internship.context')}</h2>
          <p class="text-lg leading-relaxed max-w-2xl">{internship.context[lang]}</p>
        </section>

        <!-- Tasks -->
        <section>
          <h2 class="text-label text-[var(--color-muted)] mb-8">{t('internship.tasks')}</h2>
          <ol class="list-none flex flex-col gap-6">
            {internship.tasks.map((task, i) => (
              <li class="nb-border nb-shadow bg-[var(--color-white)] p-6">
                <div class="flex items-start gap-4 mb-3">
                  <span class="text-label text-[var(--color-muted)] shrink-0 mt-1">0{i + 1}</span>
                  <h3 class="font-bold text-lg leading-tight">{task.title[lang]}</h3>
                </div>
                <p class="leading-relaxed text-sm mb-4 pl-8">{task.description[lang]}</p>
                <div class="flex flex-wrap gap-2 pl-8">
                  {task.stack.map((tech) => <Tag label={tech} />)}
                </div>
              </li>
            ))}
          </ol>
        </section>
      </div>

      <!-- Right: sidebar -->
      <aside class="px-6 md:px-12 py-16 md:py-20 flex flex-col gap-10">
        <div>
          <h2 class="text-label text-[var(--color-muted)] mb-3">Empresa</h2>
          <a
            href={internship.companyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-xl hover:underline underline-offset-4"
          >
            {internship.company} ↗
          </a>
          <p class="text-[var(--color-muted)] text-sm mt-1">
            {internship.division} · {internship.location}
          </p>
        </div>

        <div>
          <h2 class="text-label text-[var(--color-muted)] mb-3">Período</h2>
          <p class="font-bold text-xl">{internship.period}</p>
        </div>

        <div>
          <h2 class="text-label text-[var(--color-muted)] mb-4">{t('internship.competencies')}</h2>
          <ul class="flex flex-col gap-2">
            {internship.competencies[lang].map((c) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed">
                <span class="font-bold shrink-0 mt-0.5" aria-hidden="true">→</span>
                {c}
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="text-label text-[var(--color-muted)] mb-4">{t('internship.stack')}</h2>
          <div class="flex flex-wrap gap-2">
            {internship.stack.map((tech) => <Tag label={tech} />)}
          </div>
        </div>
      </aside>
    </div>

    <!-- Back to experience -->
    <a
      href={`${base}/#experience`}
      class="group flex items-center gap-4 nb-border border-x-0 border-b-0 border-t-2 px-6 md:px-12 py-10 hover:bg-[var(--color-ink)] hover:text-[var(--color-paper)] transition-colors"
    >
      <span class="text-2xl transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
      <span class="font-bold uppercase tracking-[-0.02em] text-xl">
        {t('internship.back')}
      </span>
    </a>
  </article>
</Layout>
